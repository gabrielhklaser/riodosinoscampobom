-function parseAnaLevels(xml: string, code: string): { ts: number; h: number }[] {
-  const out: { ts: number; h: number }[] = [];
-  const re = new RegExp(`${code}\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+[0-9.]+\\s+([0-9.]+)`, 'g');
-  let m: RegExpExecArray | null;
-  while ((m = re.exec(xml))) {
