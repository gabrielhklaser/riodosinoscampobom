+/* ANA para o painel: o NAVEGADOR não consegue chamar a ANA direto (o
+ * webservice não envia cabeçalhos CORS) e a antiga cadeia de proxies
+ * públicos (allorigins/corsproxy/codetabs) é instável demais para um
+ * sistema de alerta. O servidor faz a chamada oficial (sem CORS), com
+ * timeout, cache em memória (ANA não muda em segundos) e fallback para a
+ * última série válida quando o serviço estiver fora do ar. */
+const ANA_CACHE_TTL_MS = 10 * 60 * 1000;
+const anaCache = new Map(); // chave `${code}:${days}` → { readings, ts }
+
+async function getAnaSerie(code, days) {
+  const key = `${code}:${days}`;
+  const now = Date.now();
+  const hit = anaCache.get(key);
+  if (hit && now - hit.ts < ANA_CACHE_TTL_MS) {
+    return { readings: hit.readings, fetchedAt: hit.ts, stale: false };
+  }
+  try {
+    const start = new Date(now - days * 86400000);
+    const end = new Date(now + 86400000);
+    const url = `${ANA_URL}?codEstacao=${code}&dataInicio=${brDate(start)}&dataFim=${brDate(end)}`;
+    const res = await fetch(url, {
+      signal: AbortSignal.timeout(15000),
+      cache: 'no-store',
+      headers: { Accept: 'application/xml, text/xml, */*' },
+    });
+    if (!res.ok) throw new Error(`ANA HTTP ${res.status}`);
+    const xml = await res.text();
+    const readings = parseAnaXml(xml);
+    if (!readings.length) throw new Error('ANA sem registros no período');
+    anaCache.set(key, { readings, ts: now });
+    return { readings, fetchedAt: now, stale: false };
+  } catch (err) {
+    if (hit) {
+      console.error(
+        `[ana] ${code} indisponível (${err?.message || err}); usando última série válida de ${Math.round((now - hit.ts) / 60000)} min atrás`,
+      );
+      return { readings: hit.readings, fetchedAt: hit.ts, stale: true };
+    }
+    console.error(`[ana] ${code} indisponível: ${err?.message || err}`);
+    return { readings: [], fetchedAt: null, stale: true };
+  }
+}
+
 /* ------------------------------------------------------------------ */
 /* HTTP                                                                */
 /* ------------------------------------------------------------------ */
