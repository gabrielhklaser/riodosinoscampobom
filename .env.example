# Token do bot Telegram @defesacivilcampobom_bot (BotFather → /token)
# ⚠️ NUNCA commite este arquivo com valores reais — o `.env` está no
# .gitignore por uma razão. Defina as credenciais nas VARIÁVEIS DE
# AMBIENTE da plataforma onde o servidor roda (Render/Railway: aba
# Environment/Variables; VPS: arquivo .env fora do git, chmod 600).
#
# Se um token/senha for publicado no repositório por engano:
#   1) BotFather → /revoke → copie o token NOVO
#   2) Troque a ADMIN_PASSWORD
#   3) Atualize as variáveis de ambiente do servidor (nunca o git)
TELEGRAM_BOT_TOKEN=cole-aqui-o-token-do-botfather
TELEGRAM_BOT_USERNAME=defesacivilcampobom_bot

# Login do painel técnico. O servidor NÃO inicia sem senha.
ADMIN_USER=admin
ADMIN_PASSWORD=defina-uma-senha-forte

PORT=3001
HOST=0.0.0.0

# Opcional: HTTPS público do servidor (senão o bot usa polling).
# Recomendado com secret_token — o servidor passa a validar a origem do webhook:
# TELEGRAM_WEBHOOK_URL=https://seu-dominio.com/api/telegram/webhook?secret_token=um-segredo-aleatorio

# Opcional: fallback de emergência para rodar o bot a partir do navegador do
# administrador (quando o servidor não alcança a api.telegram.org). Com esta
# flag, o /api/bot/config expõe o token para administradores — mantenha
# desligado em produção.
# TELEGRAM_BROWSER_BRIDGE=1

# Opcional: avisos meteorológicos do INMET (banner no topo do painel).
# Os padrões funcionam sem nada configurar — use apenas em testes/staging:
# INMET_API_URL=https://apiprevmet3.inmet.gov.br/avisos/ativos
# INMET_CACHE_TTL_MS=720000
